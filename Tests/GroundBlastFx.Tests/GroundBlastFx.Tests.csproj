<!--
  Tests unitaires du modèle physique.
  Compile directement les sources de Source/GroundBlastFx/Physics (C# pur, sans UnityEngine) avec .NET 10.
  Aucun paquet NuGet : petit exécuteur maison (Program.cs). Lancer : dotnet run -c Release
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Source\GroundBlastFx\Physics\**\*.cs" Link="Model\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
